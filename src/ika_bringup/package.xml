<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ika_bringup</name>
  <version>0.0.0</version>
  <description>Launch files and configuration for all IKA subsystems</description>
  <maintainer email="emincaganapaydin@gmail.com">cagan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>ika_msgs</exec_depend>
  <exec_depend>ika_description</exec_depend>
  <exec_depend>ika_hardware</exec_depend>
  <exec_depend>ika_perception</exec_depend>
  <exec_depend>ika_navigation</exec_depend>
  <exec_depend>ika_teleop</exec_depend>
  <exec_depend>ika_targeting</exec_depend>
  <exec_depend>ika_autonomy</exec_depend>
  <exec_depend>ika_safety</exec_depend>
  <exec_depend>ika_recorder</exec_depend>

  <exec_depend>joy</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
